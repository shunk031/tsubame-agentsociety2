# Site-specific settings. Copy to config/env.local and fill in.
#
#   cp config/env.example config/env.local
#
# config/env.local is git-ignored. scripts/lib/common.sh sources it when
# present, and scripts/sync.sh carries it to the login node.
#
# These name one particular account and allocation, which is why they are not
# committed and why no script here takes them as an argument.

# TSUBAME group charged for jobs.
#   find it with: t4-user-info group point
TSUBAME_GROUP=

# Account used for ssh and rsync.
TSUBAME_USER=

# Login node hostname.
TSUBAME_LOGIN_HOST=

# Directory on the group area for the Python environment, model cache and run
# outputs. Needs room for tens of GB.
WORK_ROOT=

# Advance reservation id, when one applies. Leave empty to use the prior queue.
#   list yours with: qrstat
# Note that reservations may restrict which resource types they accept.
AR_ID=

# Uncomment to override the defaults in scripts/lib/common.sh.
# MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NUM_AGENTS=64
# NUM_STEPS=4
# ENABLE_THINKING=0
